// DNA (fiber-seq): dorado 2.1.2, HAC v6.0.0.
//
// Override any of these in a -params-file rather than editing here, e.g. to call
// all-context 5mC instead of CpG:
//     mod_models: ['5mC_5hmC@v1', '6mA@v1']

params {
    data_type    = 'DNA'
    stage1_image = 'dorado-2.1.2-dna.sif'

    dorado_model = 'dna_r10.4.1_e8.2_400bps_hac@v6.0.0'
    // At most ONE C model per run -- dorado rejects two models on the same canonical
    // base. Baked into the image: 5mCG_5hmCG@v1, 5mC_5hmC@v1, 4mC_5mC@v1, 6mA@v1.
    mod_models      = ['5mCG_5hmCG@v1', '6mA@v1']
    // Clair3 in Stage 2 uses r1041_e82_400bps_hac_v600_with_mv + --enable_dwell_time,
    // which reads mv on primary alignments (it skips supplementaries).
    emit_moves      = true
    estimate_poly_a = false

    // Both references; fibertools / open-chromatin run on each in Stage 2.
    align_to       = ['GRCh38', 'HG002']
    mm2_preset     = 'lr:hq'
    // -Y: soft-clip supplementaries so the tags carried through FASTQ comments stay
    // valid on them. Parabricks has no -Y; copy_tags.py --unclip does the same after.
    mm2_args       = '-Y'
    // -I 16G keeps the 6 Gbp diploid assembly in a single index part.
    mm2_index_args = '-x lr:hq -I 16G'
    pbrun_args     = ''
    // 260 = unmapped + secondary. Supplementaries are kept: they carry the split
    // reads across breakpoints that SV callers and phasing rely on.
    filter_flags   = 260

    carry_tags = 'MM,ML,MN,qs,mv'
}
