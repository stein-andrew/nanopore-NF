// RNA (RNA004 direct RNA): dorado 1.3.0, SUP v5.2.0 -- the model generation the
// gIVT dorado_1.0 error table was built from.

params {
    data_type    = 'RNA'
    stage1_image = 'dorado-1.3.0-rna.sif'

    dorado_model = 'rna004_130bps_sup@v5.2.0'
    // The usual 8 mods.
    mod_models      = ['inosine_m6A_2OmeA@v1', 'pseU_2OmeU@v1', 'm5C_2OmeC@v1', '2OmeG@v1']
    emit_moves      = true
    estimate_poly_a = true      // pt:i, used by IsoQuant

    align_to       = ['GRCh38']
    mm2_preset     = 'splice'
    mm2_args       = '-uf -k14'
    mm2_index_args = '-x splice -k14 -I 16G'
    pbrun_args     = '--forward-transcript-strand -k 14'
    filter_flags   = 2308       // unmapped + secondary + supplementary

    // pt (poly-A length) is what IsoQuant reads.
    carry_tags = 'MM,ML,MN,pt,qs,mv'

    // ======== Stage 2: RNA_analysis.nf, isoform curation (SALRR) ========
    // The annotation GTF per reference comes from the cluster profile (params.annotations).
    isoform_image    = 'isoform-salrr.sif'   // containers/isoform-salrr.def

    // SALRR keeps primary alignments with MAPQ >= 40 ("greater than 40" in one place,
    // "minimum 40" in another; samtools -q 40 keeps >= 40).
    isoform_min_mapq = 40

    // SALRR runs IsoQuant with -d nanopore --genedb <gtf> --complete_genedb and nothing else.
    isoquant_args    = ''

    // SALRR: -L -c 2.5 -f 0.05 -t (guided, no -e). --fr added: direct RNA reads are sense-strand.
    stringtie_args   = '-L -c 2.5 -f 0.05 -t --fr'

    // Per-sample model filter, before the isomatch merge: keep value > this.
    // IsoQuant models by CPM; StringTie models by TPM (it reports no read counts).
    isoform_min_cpm  = 1

    isomatch_merge_args    = ''
    isomatch_classify_args = ''

    // Cohort high-confidence set: keep catalogue transcripts whose median CPM across
    // samples (IsoQuant requantification) is > this.
    cohort_min_median_cpm  = 1
}
