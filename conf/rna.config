// RNA (RNA004 direct RNA): dorado 1.3.0, SUP v5.2.0 -- the model generation the
// gIVT dorado_1.0 error table was built from.

params {
    data_type    = 'RNA'
    stage1_image = 'dorado-1.3.0-rna.sif'

    dorado_model = 'rna004_130bps_sup@v5.2.0'
    // The usual 8 mods.
    mod_models      = ['inosine_m6A_2OmeA@v1', 'pseU_2OmeU@v1', 'm5C_2OmeC@v1', '2OmeG@v1']
    emit_moves      = true
    estimate_poly_a = true      // pt:i, used by IsoQuant

    align_to       = ['GRCh38']
    mm2_preset     = 'splice'
    mm2_args       = '-uf -k14'
    mm2_index_args = '-x splice -k14 -I 16G'
    pbrun_args     = '--forward-transcript-strand -k 14'
    filter_flags   = 2308       // unmapped + secondary + supplementary

    // pt (poly-A length) is what IsoQuant reads.
    carry_tags = 'MM,ML,MN,pt,qs,mv'

    // ======== Stage 2: RNA_analysis.nf, isoform curation (SALRR) ========
    // The annotation GTF per reference comes from the cluster profile (params.annotations).
    isoform_image    = 'isoform-salrr.sif'   // containers/isoform-salrr.def

    // SALRR keeps primary alignments with MAPQ >= 40 ("greater than 40" in one place,
    // "minimum 40" in another; samtools -q 40 keeps >= 40).
    isoform_min_mapq = 40

    // SALRR runs IsoQuant with -d nanopore --genedb <gtf> --complete_genedb and nothing else.
    // isoquant_args goes to both IsoQuant runs (discovery and requantification).
    isoquant_args    = ''

    // Requantification only, after isoquant_args (so it wins if both set the same flag).
    // unique_only (SALRR, IsoQuant's default) counts only reads assigned to exactly one
    // isoform; set explicitly so an IsoQuant upgrade cannot change it silently.
    // with_ambiguous would also count reads that fit several isoforms, split between them.
    isoquant_requant_args = '--transcript_quantification unique_only'

    // SALRR: -L -c 2.5 -f 0.05 -t (guided, no -e). --fr added: direct RNA reads are sense-strand.
    stringtie_args   = '-L -c 2.5 -f 0.05 -t --fr'

    // Per-sample model filter, before the isomatch merge: keep value > this.
    // IsoQuant models by CPM; StringTie models by TPM (it reports no read counts).
    isoform_min_cpm  = 1

    isomatch_merge_args    = ''
    isomatch_classify_args = ''

    // Cohort high-confidence set: keep catalogue transcripts whose median CPM across
    // samples (IsoQuant requantification) is > this.
    cohort_min_median_cpm  = 1

    // ======== Stage 2: RNA_analysis.nf, modifications (modkit + gIVT) ========
    // The gIVT error table is per cluster (conf/explorer.config: givt_error_table).
    mods_image = 'mods.sif'                  // containers/mods.def

    // Per-base call thresholds, used by BOTH modkit pileup and gIVT: the false-positive
    // rates gIVT subtracts are only right at the threshold the calls were made at.
    //   ''                          estimate per sample with modkit sample-probs (modkit's default)
    //   'A:0.9 C:0.85 G:0.95 T:0.9'  the same fixed thresholds for every sample
    // Must be within [0.70, 0.99): the range gIVT's error table can correct.
    mod_filter_thresholds    = ''
    modkit_filter_percentile = 0.1           // sample-probs percentile; modkit pileup's default
    modkit_sample_reads      = 10042         // reads sample-probs samples; modkit pileup's default
    modkit_max_depth         = 2147483646    // int32 max - 1: why RNA stays on modkit 0.5.0
    modkit_pileup_args       = ''

    // Filter stages: Nvalid_cov >= mods_min_coverage; then percent modified >= mods_min_percent,
    // both raw and FP-corrected.
    mods_min_coverage = 20
    mods_min_percent  = 20

    // Modification levels per isoform and per gene, at sample-level sites whose FP-corrected
    // percent is >= feature_mods_candidate_pct. 20 = the final-stage sites; lower it to also
    // find sites modified in one isoform but diluted below 20% sample-wide (more compute).
    feature_mods_candidate_pct = 20
    // modkit extract calls must reproduce the pileup at >= this fraction of candidate sites,
    // or the step stops instead of writing numbers from calls counted differently.
    feature_mods_min_agreement = 0.95
}
