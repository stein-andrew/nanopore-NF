// RNA (RNA004 direct RNA): dorado 1.3.0, SUP v5.2.0 -- the model generation the
// gIVT dorado_1.0 error table was built from.

params {
    data_type    = 'RNA'
    stage1_image = 'dorado-1.3.0-rna.sif'

    dorado_model = 'rna004_130bps_sup@v5.2.0'
    // The usual 8 mods. m6A_DRACH@v1 is also in the image but overlaps
    // inosine_m6A_2OmeA on A, so the two cannot run together.
    mod_models      = ['inosine_m6A_2OmeA@v1', 'pseU_2OmeU@v1', 'm5C_2OmeC@v1', '2OmeG@v1']
    // Kept to match the existing whole-blood data (all emit-moves). Clair3-RNA
    // (ont_dorado_drna004) does not read mv; turn off to shrink the uBAMs.
    emit_moves      = true
    estimate_poly_a = true      // pt:i, used by IsoQuant

    align_to       = ['GRCh38']
    mm2_preset     = 'splice'
    mm2_args       = '-uf -k14'
    mm2_index_args = '-x splice -k14 -I 16G'
    pbrun_args     = '--forward-transcript-strand -k 14'
    filter_flags   = 2308       // unmapped + secondary + supplementary

    // Only primary alignments survive the filter, so SEQ is never hard-clipped and
    // tags can be copied verbatim -- including mv and pt, which modkit repair cannot.
    tag_method = 'copy_tags'
    carry_tags = 'MM,ML,MN,pt,qs,mv'
}
