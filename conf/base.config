// Resources by label, and which image each process runs in. Cluster profiles
// (explorer.config, aicr.config) override queues, GPU requests and sizes.

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    // One retry for out-of-memory / out-of-time kills; anything else stops the run.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Closures, so they resolve after every profile has set params.
    container = { "${params.container_dir}/${params.stage1_image}" }
    withName: 'PBRUN_MINIMAP2' {
        container = { params.parabricks_image }
    }

    withLabel: gpu_dorado {
        cpus             = 32
        memory           = 128.GB
        time             = 20.h
        containerOptions = '--nv'
    }
    withLabel: gpu_pbrun {
        cpus             = 32
        memory           = 256.GB
        time             = 4.h
        containerOptions = '--nv'
    }
    withLabel: cpu_align {
        cpus   = 32
        memory = { 96.GB * task.attempt }
        time   = 24.h
    }
    withLabel: cpu_sort {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = 24.h
    }
    withLabel: cpu_small {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
}

apptainer {
    enabled    = true
    autoMounts = true
}
