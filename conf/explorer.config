// Northeastern Explorer (SLURM). Stage 2 always runs here; Stage 1 can too.
//
// There is no Parabricks module here, but the NGC image runs on the H200s, so
// --aligner parabricks works as well as the default CPU minimap2.

params {
    container_dir    = '/scratch/stein.an/ont-pipeline/containers'
    parabricks_image = '/scratch/stein.an/clara-parabricks_4.7.0-1.sif'
    index_dir        = '/scratch/stein.an/ont-pipeline/indexes'
    genomes = [
        GRCh38: '/projects/Genometechlab/referenceFastaFiles/human/genome/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa',
        HG002 : '/projects/Genometechlab/referenceFastaFiles/human/genome/hg002v1.1.fasta',
    ]
    // Stage 2: annotation GTF per reference, same keys as genomes. Contig names must match
    // the FASTA (GENCODE's chr-prefixed "CHR" GTF matches the no_alt analysis set).
    // SALRR classifies against GENCODE v49; v47 is what is on disk here today.
    annotations = [
        GRCh38: '/projects/Genometechlab/referenceFastaFiles/human/gencode/gencode.v47.annotation.gtf',
    ]
    // Stage 2: gIVT 9mer false-positive table. Built from dorado 1.0 / RNA004 SUP v5.2.0 calls,
    // so it only fits BAMs basecalled with the v5.2.0 models.
    givt_error_table = '/projects/Genometechlab/referenceFastaFiles/gIVT/GM12878_genomic_IVT_refmatch_9mer_all_threshold.dorado_1.0.tsv.gz'
    // Stage 2: genome-wide variant references (scripts/fetch_variant_refs.sh; MANIFEST.tsv there)
    gnomad_nuclear   = '/projects/Genometechlab/referenceFastaFiles/variants/gnomad.joint.v4.1.sites.min.bcf'
    gnomad_mito      = '/projects/Genometechlab/referenceFastaFiles/variants/gnomad.genomes.v3.1.sites.chrM.min.bcf'
    clinvar          = '/projects/Genometechlab/referenceFastaFiles/variants/clinvar.GRCh38.chr.bcf'
}

// Off $HOME: work dirs hold full-size BAMs. Same filesystem as outdir so
// workflow.output.mode = 'link' can hard-link instead of copying.
workDir = '/scratch/stein.an/ont-pipeline/work'

apptainer.runOptions = '--bind /projects/Genometechlab,/scratch'

executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
    // SLURM's controller sometimes rejects a submission with a transient error
    // ("Unexpected message received"); without this one such hiccup kills the whole run.
    // Nextflow's default retries only 'Socket timed out'. Such a "failed" submission can
    // still have been queued, so a retry can start a second copy: process.beforeScript
    // below makes that copy harmless.
    retry.reason      = 'Socket timed out|Unexpected message received|Unable to contact slurm controller'
    retry.maxAttempts = 10            // 4 rejections in a row seen (MOD_STAGES, 2026-10-26)
}

// GPU partitions (QoS limits as of 2026-09):
process {
    executor = 'slurm'
    queue    = 'short'              // CPU work; MaxTime 2 days

    // One copy per work dir. A submission SLURM reported as failed but queued anyway, plus
    // the retry, ran two copies of COHORT_CATALOGUE in one folder; one crashed on the
    // other's half-written files (2026-10-23). Each task locks its work dir first; a second
    // copy waits, then exits with the first copy's status instead of running again.
    // beforeScript runs on the node, outside the container.
    beforeScript = 'exec 9> .nxf_task.lock && flock 9 && if [[ -s .exitcode ]]; then exit "$(cat .exitcode)"; fi'

    withLabel: gpu_dorado {
        queue          = 'multigpu'
        clusterOptions = '--gres=gpu:h200:4'
        time           = 20.h
    }
    withLabel: gpu_pbrun {
        queue          = 'gpu'
        clusterOptions = '--gres=gpu:h200:1'
        time           = 8.h
    }
}
