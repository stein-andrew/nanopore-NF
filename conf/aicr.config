// AICR (Tufts-hosted, SLURM, B200). Stage 1 only.
//
// Values carried over from ~/scripts/pb_align_reads.sbatch and pb_align_array.sbatch.
// b200-devel caps at 4 h, so everything goes to b200-batch.

params {
    aligner          = 'parabricks'
    container_dir    = '/scratch/stein_an_neu/ont-pipeline/containers'
    parabricks_image = '/scratch/stein_an_neu/clara-parabricks_4.7.0-1.sif'
    index_dir        = '/scratch/stein_an_neu/ont-pipeline/indexes'
    genomes = [
        GRCh38: '/work/neu/p2026_0018_neu/referenceFastafiles/human/genome/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa',
        // TODO: HG002 diploid path on AICR. Until set, run DNA with --align_to GRCh38
        // or align to HG002 on Explorer.
        HG002 : null,
    ]
}

workDir = '/scratch/stein_an_neu/ont-pipeline/work'

// The Parabricks module binds only /scratch; references live under /work.
apptainer.runOptions = '--bind /scratch,/work'

executor {
    queueSize       = 8
    submitRateLimit = '10/1min'
}

process {
    executor = 'slurm'
    // TODO: confirm a CPU partition. Until then CPU steps (sorts, tag transfer,
    // md5) share b200-batch without requesting a GPU.
    queue    = 'b200-batch'

    withLabel: gpu_dorado {
        clusterOptions = '--gres=gpu:b200:2'
        cpus           = 64
        memory         = 256.GB
        time           = 24.h
    }
    withLabel: gpu_pbrun {
        clusterOptions = '--gres=gpu:b200:1'
        cpus           = 32
        memory         = 256.GB
        time           = 8.h
    }
}
