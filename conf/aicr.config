// AICR (Tufts-hosted, SLURM). Stage 1 only.
//
// Launch with scripts/aicr_launch.sh: the login node kills the JVM, so the Nextflow
// head job has to run under SLURM itself (cpu partition, SDKMAN Java 17).
//
// GPU nodes (as of 2026-09): 8x B200 or 8x RTX PRO 6000, 128 CPUs, 2.3 TB each; the
// per-GPU fair share is 16 CPUs / ~290 GB. SLURM's start-time estimates here are
// unreliable, so don't pick a queue by them; to use the RTX nodes instead:
// --gpu_queue rtx-batch --gpu_type rtx_pro_6000.
// b200-devel / rtx-devel: 4 h and 2 GPUs per user, fine for short runs.
//
// Images and indexes live on /work (7-day snapshots). /scratch purges files older
// than 30 days, so only the work dir and run outputs go there.

params {
    aligner          = 'parabricks'
    container_dir    = '/work/neu/p2026_0018_neu/ont-pipeline/containers'
    parabricks_image = '/work/neu/p2026_0018_neu/ont-pipeline/containers/clara-parabricks_4.7.0-1.sif'
    index_dir        = '/work/neu/p2026_0018_neu/ont-pipeline/indexes'
    genomes = [
        GRCh38: '/work/neu/p2026_0018_neu/referenceFastafiles/human/genome/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa',
        HG002 : '/work/neu/p2026_0018_neu/referenceFastafiles/human/genome/hg002v1.1.fasta',
    ]

    gpu_queue   = 'b200-batch'      // dorado; rtx-batch | b200-devel | rtx-devel
    pbrun_queue = 'b200-devel'      // one flowcell aligns in ~1-1.5 h, inside devel's 4 h cap
    gpu_type    = 'b200'            // rtx_pro_6000 on the rtx partitions (both queues)
    dorado_gpus = 2
}

workDir = '/scratch/stein_an_neu/ont-pipeline/work'

// The Parabricks module binds only /scratch; references live under /work.
apptainer.runOptions = '--bind /scratch,/work'

executor {
    queueSize       = 8
    submitRateLimit = '10/1min'
}

process {
    executor = 'slurm'
    // cpu: w0001-0005, 128 CPUs / 1.16 TB each. QoS allows 64 CPUs per user across
    // all running cpu jobs, head job included; SLURM queues the rest. Default time
    // (15 min) and memory (1 GB/CPU) are tiny, so every label sets both.
    queue    = 'cpu'

    withLabel: gpu_dorado {
        queue          = { params.gpu_queue }
        clusterOptions = { "--gres=gpu:${params.gpu_type}:${params.dorado_gpus}" }
        cpus           = { 16 * params.dorado_gpus }
        memory         = 256.GB
        time           = 24.h
    }
    // pbrun minimap2 is CPU-bound on B200 (benchmark 2026-09-23, 300k DNA reads):
    //   1 GPU/16 CPUs 290 s, 1 GPU/32 CPUs 171 s, 2 GPUs/32 CPUs 172 s.
    // So 1 GPU (params.pbrun_gpus) with 32 CPUs; run flowcells as parallel 1-GPU
    // jobs. ~30 Mb/s at this size; peak host RSS ~65 GiB (keep 256 GB until a full
    // flowcell confirms it does not grow). For inputs past ~4 h, --pbrun_queue
    // b200-batch and raise time.
    withLabel: gpu_pbrun {
        queue          = { params.pbrun_queue }
        clusterOptions = { "--gres=gpu:${params.gpu_type}:${params.pbrun_gpus}" }
        cpus           = 32
        memory         = 256.GB
        time           = 4.h
    }
}
