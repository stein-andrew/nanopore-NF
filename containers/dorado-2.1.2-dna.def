Bootstrap: docker
From: ubuntu:24.04

# Stage 1 image for DNA: basecall -> (CPU align) -> tag repair.
# Portable between Explorer and AICR; GPU access at run time needs `apptainer --nv`.
#
# All four HAC v6.0.0 mod models are baked in, but dorado accepts only ONE model per
# canonical base ("only one modbase model motif per canonical base is allowed"), so a
# run uses 6mA plus one C model. The choice lives in conf/dna.config (params.mod_models).
#
# modkit here is the CPU bioconda build, used only for `modkit repair`. The GPU (tch)
# build for open-chromatin predict belongs to the Stage 2 image.

%labels
    Stage       1 (basecall + align)
    DataType    DNA
    Dorado      2.1.2
    BaseModel   dna_r10.4.1_e8.2_400bps_hac@v6.0.0
    ModModels   5mCG_5hmCG@v1 5mC_5hmC@v1 4mC_5mC@v1 6mA@v1
    Samtools    1.21
    Minimap2    2.28
    Modkit      0.6.4

%post -c /bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends curl ca-certificates bzip2 procps
    rm -rf /var/lib/apt/lists/*

    DORADO_VERSION=2.1.2
    cd /opt
    curl -fsSL "https://cdn.oxfordnanoportal.com/software/analysis/dorado-${DORADO_VERSION}-linux-x64.tar.gz" \
        | tar -xz
    mv "dorado-${DORADO_VERSION}-linux-x64" /opt/dorado

    BASE=dna_r10.4.1_e8.2_400bps_hac@v6.0.0
    mkdir -p /opt/models
    for m in "${BASE}" \
             "${BASE}_5mCG_5hmCG@v1" \
             "${BASE}_5mC_5hmC@v1" \
             "${BASE}_4mC_5mC@v1" \
             "${BASE}_6mA@v1"; do
        /opt/dorado/bin/dorado download --model "$m" --models-directory /opt/models
    done

    # Tool versions match the existing CPU alignments (minimap2 2.28, samtools 1.21).
    curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local bin/micromamba
    /usr/local/bin/micromamba create -y -p /opt/conda -c conda-forge -c bioconda \
        python=3.12 samtools=1.21 minimap2=2.28 ont-modkit=0.6.4
    /usr/local/bin/micromamba clean -afy

%environment
    export PATH=/opt/conda/bin:/opt/dorado/bin:$PATH
    export DORADO_MODELS_DIRECTORY=/opt/models

%runscript
    exec "$@"

%test
    dorado --version
    samtools --version | head -1
    minimap2 --version
    modkit --version
    ls /opt/models

%help
    Build (see containers/build.sh):
        apptainer build --fakeroot dorado-2.1.2-dna.sif dorado-2.1.2-dna.def
    Models: /opt/models (also DORADO_MODELS_DIRECTORY)
