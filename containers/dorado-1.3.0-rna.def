Bootstrap: docker
From: ubuntu:24.04

# Stage 1 image for RNA: basecall -> (CPU align) -> tag transfer.
# Portable between Explorer and AICR (or any future clusters with an updated conf.); 
# GPU access at run time needs `apptainer --nv`.
#
# v5.2.0 SUP models, because the gIVT error table for v5.2.0 (dorado_1.0) is the one
# that matches them. The default run uses the four models that give the usual 8 mods.
#
# modkit is pinned to 0.5.0 for RNA end to end (used for the ability to keep --max-depth at int32 limit).
# If using synthetics or known transcriptome where lower coverage can be permitted, update to modkit>=0.6.4
# for significant speedup.

%labels
    Stage       1 (basecall + align)
    DataType    RNA
    Dorado      1.3.0
    BaseModel   rna004_130bps_sup@v5.2.0
    ModModels   inosine_m6A_2OmeA@v1 pseU_2OmeU@v1 m5C_2OmeC@v1 2OmeG@v1 m6A_DRACH@v1
    Samtools    1.21
    Minimap2    2.28
    Modkit      0.5.0

%post -c /bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends curl ca-certificates bzip2 procps
    rm -rf /var/lib/apt/lists/*

    DORADO_VERSION=1.3.0
    cd /opt
    curl -fsSL "https://cdn.oxfordnanoportal.com/software/analysis/dorado-${DORADO_VERSION}-linux-x64.tar.gz" \
        | tar -xz
    mv "dorado-${DORADO_VERSION}-linux-x64" /opt/dorado

    BASE=rna004_130bps_sup@v5.2.0
    mkdir -p /opt/models
    for m in "${BASE}" \
             "${BASE}_inosine_m6A_2OmeA@v1" \
             "${BASE}_pseU_2OmeU@v1" \
             "${BASE}_m5C_2OmeC@v1" \
             "${BASE}_2OmeG@v1" \
             "${BASE}_m6A_DRACH@v1"; do
        /opt/dorado/bin/dorado download --model "$m" --models-directory /opt/models
    done

    curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local bin/micromamba
    /usr/local/bin/micromamba create -y -p /opt/conda -c conda-forge -c bioconda \
        python=3.12 samtools=1.21 minimap2=2.28 ont-modkit=0.5.0
    /usr/local/bin/micromamba clean -afy

%environment
    export PATH=/opt/conda/bin:/opt/dorado/bin:$PATH
    export DORADO_MODELS_DIRECTORY=/opt/models

%runscript
    exec "$@"

%test
    dorado --version
    samtools --version | head -1
    minimap2 --version
    modkit --version
    ls /opt/models

%help
    Build (see containers/build.sh):
        apptainer build --fakeroot dorado-1.3.0-rna.sif dorado-1.3.0-rna.def
    Models: /opt/models (also DORADO_MODELS_DIRECTORY)
