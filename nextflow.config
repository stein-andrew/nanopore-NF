// ont-pipeline
//
//   Stage 1  basecall.nf   pod5 -> dorado -> align -> mod-tag transfer -> BAM   (AICR or Explorer)
//   Stage 2  analysis.nf   aligned BAMs -> DNA / RNA analysis                  (Explorer)
//
// Pick the data type and the cluster with profiles:
//   nextflow run basecall.nf -profile aicr,dna -params-file my_run.yaml
//   nextflow run basecall.nf -profile explorer,rna --input sheet.csv --outdir results/run1

manifest {
    name            = 'ont-pipeline'
    description     = 'ONT DNA/RNA basecalling, alignment and analysis across Explorer and AICR'
    nextflowVersion = '>=25.10.0'
}

params {
    input        = null        // Stage 1 samplesheet: sample_id,run_id,pod5[,extra columns]
    outdir       = 'results'

    // Set by -profile dna | rna
    data_type       = null
    stage1_image    = ''
    dorado_model    = null
    mod_models      = []
    emit_moves      = false
    estimate_poly_a = false
    dorado_device   = 'cuda:all'
    dorado_args     = ''

    // Alignment. genomes (name -> FASTA) comes from the cluster profile; align_to
    // (which of them to use) comes from the data-type profile.
    aligner        = 'minimap2'     // minimap2 | parabricks
    genomes        = [:]
    align_to       = []
    mm2_preset     = null
    mm2_args       = ''             // CPU minimap2 only
    mm2_index_args = null           // must match the preset (and -k) used to align
    pbrun_args     = ''
    pbrun_gpus     = 1              // a second GPU adds nothing (CPU-bound; see aicr.config)
    filter_flags   = null           // samtools view -F after alignment

    // Tag transfer after Parabricks (which drops MM/ML). The CPU path carries
    // carry_tags through FASTQ comments instead and needs no transfer.
    tag_method = null               // modkit_repair | copy_tags
    carry_tags = null               // mv is dropped automatically when emit_moves is false

    publish_ubam = true

    // Set by the cluster profile
    container_dir    = ''
    parabricks_image = ''
    index_dir        = ''         // cached .fai / .mmi per reference
}

includeConfig 'conf/base.config'

profiles {
    dna      { includeConfig 'conf/dna.config' }
    rna      { includeConfig 'conf/rna.config' }
    explorer { includeConfig 'conf/explorer.config' }
    aicr     { includeConfig 'conf/aicr.config' }
    // No containers, no scheduler: for -stub-run checks of the DAG.
    stub {
        apptainer.enabled = false
        process.executor  = 'local'
        process.resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
        params.container_dir    = 'stub'
        params.parabricks_image = 'stub'
    }
}

outputDir = params.outdir

// Hard links: instant and free when outdir and workDir share a filesystem (both on
// /scratch in the cluster profiles). rsync copies the content, so the transfer is
// unaffected. Use 'copy' if outdir lives on a different filesystem.
workflow.output.mode = 'link'

// overwrite: a -resume into the same outdir would otherwise refuse to write them.
timeline.enabled   = true
timeline.overwrite = true
timeline.file      = "${params.outdir}/pipeline_info/timeline.html"
report.enabled     = true
report.overwrite   = true
report.file        = "${params.outdir}/pipeline_info/report.html"
trace.enabled      = true
trace.overwrite    = true
trace.file         = "${params.outdir}/pipeline_info/trace.tsv"
